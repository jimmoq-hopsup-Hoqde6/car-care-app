# Local SQLite database (created automatically on first run)
DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth — required even in demo mode
# Generate a new value with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Demo mode shows sample jobs and fake inbox/calendar slots.
# Set to false once Google OAuth is connected and you want live Gmail + Calendar.
DEMO_MODE="true"

# Google Cloud OAuth client (Desktop or Web application)
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
# Leave blank to stay in demo mode.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Scopes requested when Marcel connects Google (see README):
# - openid email profile
# - https://www.googleapis.com/auth/gmail.modify
# - https://www.googleapis.com/auth/calendar

# Phase 1.5 automations — used as first-run defaults; also editable on Settings.
# Quotes and booking confirmations NEVER auto-send.
FOLLOW_UP_DAYS="2"
REVIEW_ASK_DAYS_AFTER_JOB="1"
GOOGLE_REVIEW_URL="https://maps.app.goo.gl/UJcUi9ouWQaVn71D8?g_st=ic"

# Optional: require this Bearer token for GET/POST /api/automations/run
# AUTOMATIONS_SECRET=""

# Marcel's existing mobile — the only SMS number (MessageMedia source_number +61435222221).
OWNER_MOBILE="0435222221"

# Sinch MessageMedia (optional). Demo mode never calls the live API.
# Authorise 0435222221 under Numbers → My own numbers, then:
# MESSAGEMEDIA_API_KEY=""
# MESSAGEMEDIA_API_SECRET=""
# Inbound + delivery webhook: {AUTH_URL}/api/sms/messagemedia
