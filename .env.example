# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local demo: SQLite file (created automatically on first run).
DATABASE_URL="file:./dev.db"
#
# Hosted (Vercel / similar): SQLite will NOT persist on serverless.
# Use Neon, Vercel Postgres, or another Postgres host, then set e.g.:
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Prefer Neon's pooled URL (-pooler) for serverless.
# Leave this as file:./dev.db on your laptop.

# -----------------------------------------------------------------------------
# Auth.js / NextAuth — Google Sign-In
# AUTH_* and NEXTAUTH_* are both accepted (same values).
# Generate a secret: openssl rand -base64 32
# Do not commit real secrets.
# -----------------------------------------------------------------------------
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Who can open the hosted job desk. Comma-separated, case-insensitive.
# Default if unset: Marcel's business accounts below.
AUTH_ALLOWLIST="info@mobilecarscratchrepairadelaide.com.au,moogly88@gmail.com"

# Demo / local stays open without a login gate when DEMO_MODE=true
# or when AUTH_SECRET / NEXTAUTH_SECRET is missing.
# Hosted phone access: DEMO_MODE=false and set the secrets above.
DEMO_MODE="true"

# Google Cloud OAuth client (Web application).
# Local redirect:  http://localhost:3000/api/auth/callback/google
# Hosted redirect: https://YOUR-APP.vercel.app/api/auth/callback/google
# Leave blank to stay in local demo mode.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Scopes requested when Marcel signs in / connects Google (see README):
# - openid email profile
# - https://www.googleapis.com/auth/gmail.modify
# - https://www.googleapis.com/auth/calendar

# Phase 1.5 automations — used as first-run defaults; also editable on Settings.
# Quotes and booking confirmations NEVER auto-send.
FOLLOW_UP_DAYS="2"
REVIEW_ASK_DAYS_AFTER_JOB="1"
GOOGLE_REVIEW_URL="https://maps.app.goo.gl/UJcUi9ouWQaVn71D8?g_st=ic"

# Optional: require this Bearer token for GET/POST /api/automations/run
# AUTOMATIONS_SECRET=""

# Marcel's existing mobile — the only SMS number (MessageMedia source_number +61435222221).
OWNER_MOBILE="0435222221"

# Sinch MessageMedia (optional). Demo mode never calls the live API.
# Authorise 0435222221 under Numbers → My own numbers, then:
# MESSAGEMEDIA_API_KEY=""
# MESSAGEMEDIA_API_SECRET=""
# Inbound + delivery webhook: {AUTH_URL or NEXTAUTH_URL}/api/sms/messagemedia
