# Local SQLite database (created automatically on first run)
DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth — required even in demo mode
# Generate a new value with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Demo mode shows sample jobs and fake inbox/calendar slots.
# Set to false once Google OAuth is connected and you want live Gmail + Calendar.
DEMO_MODE="true"

# Google Cloud OAuth client (Desktop or Web application)
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
# Leave blank to stay in demo mode.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Scopes requested when Marcel connects Google (see README):
# - openid email profile
# - https://www.googleapis.com/auth/gmail.modify
# - https://www.googleapis.com/auth/calendar
