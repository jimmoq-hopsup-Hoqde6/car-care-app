generator client {
  provider = "prisma-client-js"
}

// Local demo uses SQLite. Hosted Vercel must use Postgres (Neon / Vercel Postgres).
// `scripts/sync-prisma-provider.js` rewrites this provider from DATABASE_URL at build.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  NEEDS_QUOTE
  AWAITING_CUSTOMER
  READY_TO_BOOK
  BOOKED
  DONE
}

model Job {
  id              String    @id
  customerName    String
  customerEmail   String?
  customerPhone   String?
  customerPhoneE164 String?
  vehicle         String?
  suburb          String?
  address         String?
  damageNotes     String?
  repairItems     String    @default("[]")
  channel         String    @default("email")
  threadId        String?
  gmailThreadId   String?
  status          JobStatus @default(NEEDS_QUOTE)
  quoteAmount     Float?
  bookedStart     DateTime?
  bookedEnd       DateTime?
  calendarEventId String?
  isDemo          Boolean   @default(false)
  lastOutboundAt  DateTime?
  followUpSentAt  DateTime?
  reviewAskSentAt DateTime?
  quoteSentAt     DateTime?
  awaitingSince   DateTime?
  completedAt     DateTime?
  lastCustomerReplyAt DateTime?
  followUpSkippedAt DateTime?
  reviewAskSkippedAt DateTime?
  lastActivityAt  DateTime  @default(now())
  photoAskSentAt  DateTime?
  declinedAt      DateTime?
  outOfScope      Boolean   @default(false)
  photos          Photo[]
  drafts          EmailDraft[]
  automations     AutomationEvent[]
  notifications   Notification[]
  smsMessages     SmsMessage[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Photo {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  url       String
  filename  String?
  source    String   @default("upload")
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model EmailDraft {
  id           String    @id @default(cuid())
  jobId        String
  job          Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type         String
  subject      String
  body         String
  gmailDraftId String?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
}

model PriceBand {
  id          String  @id @default(cuid())
  name        String
  amount      Float?
  sortOrder   Int     @default(0)
}

model AppSetting {
  id                     String @id @default("default")
  workStartHour          Int    @default(8)
  workEndHour            Int    @default(16)
  workDays               String @default("[1,2,3,4,5]")
  jobDurationHours       Int    @default(3)
  timezone               String @default("Australia/Adelaide")
  ownerName              String @default("Marcel Kuhn")
  businessName           String @default("Mobile Car Scratch Repair Adelaide")
  businessEmail          String @default("Info@mobilecarscratchrepairadelaide.com.au")
  followUpDays           Int    @default(2)
  reviewAskDaysAfterJob  Int    @default(1)
  googleReviewUrl        String @default("https://maps.app.goo.gl/UJcUi9ouWQaVn71D8?g_st=ic")
  autoAskPhotos          Boolean @default(false)
  autoDeclineOutOfScope  Boolean @default(false)
  autoSmsPhotoAsk        Boolean @default(false)
  autoSmsFollowUp        Boolean @default(false)
  autoAddInboxToBoard    Boolean @default(true)
  messageMediaKey        String?
  messageMediaSecret     String?
}

model AutomationEvent {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type      String
  subject   String
  body      String
  toEmail   String
  delivered Boolean  @default(false)
  demo      Boolean  @default(true)
  error     String?
  createdAt DateTime @default(now())
}

model SmsMessage {
  id           String   @id @default(cuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  direction    String
  body         String
  fromNumber   String
  toNumber     String
  provider     String   @default("messagemedia")
  providerId   String?
  status       String   @default("queued")
  delivered    Boolean  @default(false)
  demo         Boolean  @default(false)
  type         String   @default("reply")
  error        String?
  createdAt    DateTime @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  jobId     String?
  job       Job?      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model GoogleAccount {
  id           String   @id @default("default")
  email        String?
  accessToken  String?
  refreshToken String?
  expiresAt    Int?
  updatedAt    DateTime @updatedAt
}
